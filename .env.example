

# --- Required ---------------------------------------------------------------

# AWS Bedrock API key (bearer token) for Claude access.
COMPANION_LLM_API_KEY=

# --- LLM serving (optional overrides) ---------------------------------------

# COMPANION_AWS_REGION=us-east-1
# COMPANION_CHAT_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# COMPANION_EXTRACT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# COMPANION_JUDGE_MODEL=                     # defaults to COMPANION_CHAT_MODEL
# COMPANION_CHAT_MAX_TOKENS=2048
# COMPANION_EXTRACT_MAX_TOKENS=2048

# --- Embeddings (optional, OFF by default) ----------------------------------
# Off out of the box — no local model server required to run this project.
# Semantic retrieval and reconciliation use a vector when enabled; without one,
# both fall back to entity/subject matching — see src/embeddings.py. Opt in
# with COMPANION_EMBEDDINGS_ENABLED=true once Ollama (or another embeddings
# endpoint) is running locally.

# COMPANION_EMBEDDINGS_ENABLED=false
#
# Any OpenAI-embeddings-compatible endpoint works here (Ollama by default, a
# hosted Ollama, or a cloud provider):
# COMPANION_EMBED_BASE_URL=http://localhost:11434/v1
# COMPANION_EMBED_API_KEY=ollama
# COMPANION_EMBED_MODEL=nomic-embed-text
# COMPANION_EMBED_DIM=768

# --- Storage & persona (optional) -------------------------------------------

# COMPANION_DB=                              # defaults to ./companion_<persona>.db
# COMPANION_PERSONA=                         # pin one persona file; unset shows the picker
# COMPANION_PERSONAS_DIR=./personas          # where selectable persona YAMLs live
