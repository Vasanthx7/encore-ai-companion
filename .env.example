# Template for local secrets. Copy to .env and fill in:
#     cp .env.example .env
# .env is gitignored; this example is committed. Loaded by config.py via python-dotenv.

# AWS Bedrock API key (bearer token). Used as AWS_BEARER_TOKEN_BEDROCK.
COMPANION_LLM_API_KEY=

# Optional overrides:
# COMPANION_AWS_REGION=us-east-1
# COMPANION_CHAT_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# COMPANION_EXTRACT_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Embeddings are optional. Without them, retrieval and reconciliation fall back
# to entity/subject matching instead of semantic similarity. Set to false if you
# don't have Ollama (or another embeddings endpoint) running locally.
# COMPANION_EMBEDDINGS_ENABLED=true
#
# Point these at any OpenAI-embeddings-compatible endpoint (Ollama by default,
# a hosted Ollama, or a cloud provider like OpenAI):
# COMPANION_EMBED_BASE_URL=http://localhost:11434/v1
# COMPANION_EMBED_API_KEY=ollama
# COMPANION_EMBED_MODEL=nomic-embed-text
# COMPANION_EMBED_DIM=768
